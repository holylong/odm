{
  "manifest_version": 3,
  "name": "ODM Integration Module",
  "version": "1.0.0",
  "description": "Hands downloads to Open Download Manager. Same role as IDM's browser extension: decide takeover, forward the URL with its referer and cookies.",
  "minimum_chrome_version": "109",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "cookies",
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ODM",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/logo16.png",
    "32": "icons/logo32.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  }
}
